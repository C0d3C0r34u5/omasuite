main.o: src/main.cpp src/appcore.h \
		src/account/accountmanager.h \
		src/mail/mailmodel.h \
		src/calendar/calendarmodel.h \
		src/contacts/contactmodel.h \
		src/tasks/taskmodel.h \
		src/net/synccontroller.h \
		src/net/oauth2manager.h \
		src/storage/database.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o src/main.cpp

appcore.o: src/appcore.cpp src/appcore.h \
		src/account/accountmanager.h \
		src/mail/mailmodel.h \
		src/calendar/calendarmodel.h \
		src/contacts/contactmodel.h \
		src/tasks/taskmodel.h \
		src/net/synccontroller.h \
		src/net/oauth2manager.h \
		src/account/provider.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o appcore.o src/appcore.cpp

database.o: src/storage/database.cpp src/storage/database.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o database.o src/storage/database.cpp

secretstore.o: src/storage/secretstore.cpp src/storage/secretstore.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o secretstore.o src/storage/secretstore.cpp

account.o: src/account/account.cpp src/account/account.h \
		src/account/provider.h \
		src/storage/secretstore.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o account.o src/account/account.cpp

